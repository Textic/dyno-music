{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ytm-remote",
  "description": "The bridge injected into music.youtube.com may only report back to Rust",
  "windows": ["player"],
  "remote": {
    "urls": ["https://music.youtube.com/*"]
  },
  "permissions": [
    "allow-bridge-ready",
    "allow-bridge-state",
    "allow-bridge-response",
    "allow-bridge-log"
  ]
}
